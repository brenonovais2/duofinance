generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                  String              @id @default(uuid())
  ownerId             String?             
  nome                String
  despesas            Despesa[]           @relation("DespesasPagas")
  despesasRecorrentes DespesaRecorrente[] @relation("RecorrentesPagas")
  transacoesMeta      TransacaoMeta[]     @relation("UsuarioTransacaoMeta")
}

model Cartao {
  id            String    @id @default(uuid())
  ownerId       String    @default("") // Temporário para não quebrar dados antigos
  nome          String
  limite        Float?
  diaVencimento Int
  diaFechamento Int
  faturas       Fatura[]
  despesas      Despesa[]
  despesasRecorrentes DespesaRecorrente[]
}

model Fatura {
  id          String    @id @default(uuid())
  ownerId     String    @default("")
  cartaoId    String
  cartao      Cartao    @relation(fields: [cartaoId], references: [id], onDelete: Cascade)
  mes         Int       // 1 a 12
  ano         Int
  status      String    @default("Aberta") // Aberta, Fechada, Paga
  despesas    Despesa[]
}

model Despesa {
  id            String   @id @default(uuid())
  ownerId       String    @default("")
  descricao     String
  valor         Float
  data          DateTime @default(now())
  categoria     String   @default("Outros")
  vencimento    DateTime @default(now())
  statusPago    Boolean  @default(false)
  faturaCartao  String?  
  pagoPorId     String
  pagoPor       Usuario  @relation("DespesasPagas", fields: [pagoPorId], references: [id])

  tipoRateio    String   @default("50_50")
  beneficiadoId String?
  rateioPagador Float?

  cartaoId      String?
  cartao        Cartao?  @relation(fields: [cartaoId], references: [id])
  faturaId      String?
  fatura        Fatura?  @relation(fields: [faturaId], references: [id])
  
  parcelaAtual  Int?
  totalParcelas Int?
  grupoParcelamentoId String?
}

model DespesaRecorrente {
  id            String   @id @default(uuid())
  ownerId       String   @default("")
  descricao     String
  valor         Float
  categoria     String   @default("Outros")
  diaVencimento Int
  status        String   @default("Ativa") // Ativa, Pausada, Arquivada
  ultimaGeracao DateTime?

  pagoPorId     String
  pagoPor       Usuario  @relation("RecorrentesPagas", fields: [pagoPorId], references: [id])

  tipoRateio    String   @default("50_50")
  beneficiadoId String?
  rateioPagador Float?

  cartaoId      String?
  cartao        Cartao?  @relation(fields: [cartaoId], references: [id])
}

model MetaFinanceira {
  id          String    @id @default(uuid())
  ownerId     String    @default("")
  titulo      String
  valorAlvo   Float
  dataAlvo    DateTime?
  fotoCapa    String?   
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  transacoes  TransacaoMeta[]
}

model TransacaoMeta {
  id          String         @id @default(uuid())
  ownerId     String         @default("")
  metaId      String
  meta        MetaFinanceira @relation(fields: [metaId], references: [id], onDelete: Cascade)
  valor       Float          // Positivo para aporte, negativo para retirada
  data        DateTime       @default(now())
  tipo        String         // "Aporte" ou "Retirada"
  usuarioId   String
  usuario     Usuario        @relation("UsuarioTransacaoMeta", fields: [usuarioId], references: [id])
  descricao   String?
}