generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id        String    @id @default(uuid())
  nome      String
  despesas  Despesa[] @relation("DespesasPagas")
}

model Cartao {
  id            String    @id @default(uuid())
  nome          String
  limite        Float?
  diaVencimento Int
  diaFechamento Int
  faturas       Fatura[]
  despesas      Despesa[]
}

model Fatura {
  id          String    @id @default(uuid())
  cartaoId    String
  cartao      Cartao    @relation(fields: [cartaoId], references: [id], onDelete: Cascade)
  mes         Int       // 1 a 12
  ano         Int
  status      String    @default("Aberta") // Aberta, Fechada, Paga
  despesas    Despesa[]
}

model Despesa {
  id            String   @id @default(uuid())
  descricao     String
  valor         Float
  data          DateTime @default(now())
  categoria     String   @default("Outros")
  vencimento    DateTime @default(now())
  statusPago    Boolean  @default(false)
  faturaCartao  String?  
  pagoPorId     String
  pagoPor       Usuario  @relation("DespesasPagas", fields: [pagoPorId], references: [id])

  cartaoId      String?
  cartao        Cartao?  @relation(fields: [cartaoId], references: [id])
  faturaId      String?
  fatura        Fatura?  @relation(fields: [faturaId], references: [id])
  
  parcelaAtual  Int?
  totalParcelas Int?
}